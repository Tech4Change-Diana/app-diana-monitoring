# DIANA — núcleo de background (app-diana-monitoring)
# Copie para `.env` e ajuste. NUNCA versione o `.env` (está no .gitignore).

# --- ingestor ---
# mock (default) | real | both
INGEST_MODE=mock

# --- Telegram / ingestor (necessário apenas quando INGEST_MODE=real|both) ---
# Segredo do BotFather. Em produção use env da Container Instance ou OCI Vault.
TELEGRAM_BOT_TOKEN=
# IDs dos grupos/chats de teste permitidos (CSV). Ex.: -1001234567890,-1009876543210
TELEGRAM_ALLOWED_CHAT_IDS=
# JSON: chatId -> userId da "criança" simulada. Ex.: {"-1001234567890":"55123456"}
DIANA_CHILD_MEMBER_MAP={}
# Segundos de long-polling do getUpdates (estratégia "drain"). 0 = sem espera.
TELEGRAM_POLL_TIMEOUT_SECONDS=0

# --- cadência / janela ---
# Cadência do batch, em horas.
BATCH_HOURS=2
# N: nº de partições recuperadas (janela = N x BATCH ≈ 6h).
WINDOW_PARTITIONS=3

# --- analyzer ---
# mock (default) | oci  (futuro: gateway OCI GenAI, repo app-diana-llm-analyzer)
ANALYZER_MODE=mock

# --- persistência (StateStore) ---
# file (dev/CI/local) | oci  (OCI Object Storage — próximo PR)
STATE_BACKEND=file
# Diretório do FileStateStore (quando STATE_BACKEND=file).
STATE_DIR=./.state
# Bucket/namespace do OCI Object Storage (quando STATE_BACKEND=oci).
OCI_OS_BUCKET=diana-monitoring
OCI_OS_NAMESPACE=

# --- logging ---
# debug | info | warn | error
LOG_LEVEL=info
